# ---------------------------------------------------------------------------
# Mai Voice (ElevenLabs) — SERVER SIDE ONLY
# These are read by the `mai-voice` Edge Function (Deno.env) and by
# `supabase/functions/_shared/maiVoiceProvider.ts`.
# NEVER give them a VITE_ prefix: that would ship the API key to the browser.
#
# Deploy them to the Edge Functions with:
#   npx supabase secrets set ELEVENLABS_API_KEY=<key> MAI_VOICE_PROVIDER=elevenlabs
# ---------------------------------------------------------------------------

# API key from https://elevenlabs.io/app/settings/api-keys (Starter plan or above
# is required for instant voice cloning and for commercial use of the audio).
ELEVENLABS_API_KEY=

# Which provider the server should use. "elevenlabs" (default) or "none" to
# disable speech generation without touching the other settings.
MAI_VOICE_PROVIDER=elevenlabs

# Voice id of the shared "Mai Voice" that is used when a user has no personal
# clone (or when the provider rejects the sample). Leave empty to disable the
# fallback. Find it in the ElevenLabs Voice Library.
MAI_VOICE_FALLBACK_VOICE_ID=

# Model used for chat speech. eleven_flash_v2_5 is the cheapest/fastest tier
# ($0.04 per 1K characters); use eleven_multilingual_v2 for higher quality.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Output format. mp3_22050_32 keeps the LiveKit audio light for live chat;
# mp3_44100_128 is the higher quality variant (paid tiers).
ELEVENLABS_TTS_FORMAT=mp3_22050_32

