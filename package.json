{
  "name": "Mai Troll",
  "version": "1.2.5",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.x <25.0"
  },
  "scripts": {
    "dev": "node ./scripts/generate-version.js && vite",
    "server": "node ./server/index.js",
    "server:watch": "tsx watch ./server/index.ts",
    "build": "node ./scripts/generate-version.js && vite build",
    "build:web": "npm run build",
    "lint": "eslint .",
    "run:migrations": "node ./scripts/run_migrations.js",
    "run:migration:file": "node ./scripts/run_migrations.js",
    "check:sounds": "node ./scripts/check_sounds.js",
    "cap:init": "cap init Maitroll com.maitroll.app --web-dir=dist",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync",
    "cap:sync:android": "npm run build && cap sync android",
    "cap:sync:ios": "npm run build && cap sync ios",
    "cap:sync:both": "npm run build && cap sync ios && cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run cap:sync:android && cap run android --livereload --external",
    "deploy:edge": "supabase functions deploy --no-verify-jwt",
    "deploy:mux-webhook": "supabase functions deploy mux-webhook --no-verify-jwt",
    "postinstall": "node scripts/setup-githooks.js",
    "desktop:dev": "tsx electron/main.ts",
    "desktop:compile": "tsc -p electron/tsconfig.json",
    "desktop:build": "npm run desktop:compile && electron-builder --win",
    "desktop:dist": "npm run desktop:compile && electron-builder --win nsis",
    "desktop:pack": "npm run desktop:compile && electron-builder --win --dir"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/loaders": "^7.54.3",
    "@babylonjs/materials": "^7.54.3",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@ffmpeg/ffmpeg": "^0.12.6",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@mux/mux-node": "^12.8.1",
    "@paypal/react-paypal-js": "^8.9.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/rapier": "^1.5.0",
    "@remotion/bundler": "^4.0.443",
    "@remotion/cli": "^4.0.443",
    "@remotion/player": "^4.0.443",
    "@rive-app/react-canvas": "^4.27.3",
    "@stripe/stripe-js": "^3.3.0",
    "@tanstack/react-query": "^5.90.16",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@types/three": "^0.185.1",
    "@vercel/node": "^4.0.0",
    "@vercel/og": "^1.0.0",
    "@zxing/library": "^0.21.3",
    "agora-rtc-sdk-ng": "^4.24.3",
    "agora-token": "^2.0.5",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.6",
    "busboy": "^1.6.0",
    "cannon-es": "^0.20.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "face-api.js": "^0.20.0",
    "faker": "^6.6.6",
    "framer-motion": "^12.23.24",
    "gltfjsx": "^6.5.3",
    "gsap": "^3.14.2",
    "hls.js": "^1.6.16",
    "howler": "^2.2.4",
    "jsbarcode": "^3.12.3",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.2",
    "keytar": "^7.9.0",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.17.3",
    "livekit-server-sdk": "^2.15.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "node-fetch": "^3.3.2",
    "obs-websocket-js": "^5.0.8",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-confetti-explosion": "^3.0.3",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-grid-layout": "^2.2.3",
    "react-icons": "^5.7.0",
    "react-leaflet": "^4.2.1",
    "react-refresh": "^0.18.0",
    "react-router-dom": "^6.28.0",
    "react-swipeable": "^7.0.2",
    "react-virtuoso": "^4.18.1",
    "recharts": "^2.15.0",
    "remotion": "^4.0.443",
    "serialize-javascript": "^6.0.2",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^1.7.0",
    "stripe": "^14.25.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tesseract.js": "^5.1.1",
    "three": "^0.171.0",
    "tsparticles-slim": "^2.12.0",
    "tsx": "^4.21.0",
    "undici": "^6.21.1",
    "uuid": "^11.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vite-tsconfig-paths": "^5.1.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@rolldown/pluginutils": "^1.0.0-rc.10",
    "@supabase/supabase-js": "^2.47.2",
    "@types/busboy": "^1.5.4",
    "@types/d3-color": "^3.1.3",
    "@types/d3-ease": "^3.0.2",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.2.3",
    "dotenv": "^16.4.7",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "express": "^4.21.2",
    "find-config": "^1.0.0",
    "glob": "^11.0.0",
    "globals": "^15.13.0",
    "lodash": "^4.17.21",
    "pg": "^8.13.1",
    "picomatch": "^4.0.2",
    "qs": "^6.13.1",
    "rollup": "^4.28.1",
    "supabase": "^2.95.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vite-plugin-mkcert": "^1.17.6",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "undici": "^6.21.1",
    "qs": "^6.13.1",
    "dompurify": "^3.2.3",
    "serialize-javascript": "^6.0.2",
    "rollup": "^4.28.1",
    "picomatch": "^4.0.2",
    "busboy": "^1.6.0"
  },
  "build": {
    "appId": "com.maitroll.desktop",
    "productName": "MaiTroll",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/keytar/**"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "public/icons/maitroll.ico",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/maitroll.ico",
      "publisherName": "MaiTroll"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MaiTroll",
      "installerIcon": "public/icons/maitroll.ico",
      "uninstallerIcon": "public/icons/maitroll.ico",
      "installerHeaderIcon": "public/icons/maitroll.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/nsis.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "maitroll",
      "repo": "maitroll",
      "releaseType": "release"
    }
  }
}
